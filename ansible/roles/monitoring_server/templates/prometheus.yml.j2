global:
  scrape_interval: 15s
  evaluation_interval: 15s


rule_files:
  - /etc/prometheus/alerts.yml


scrape_configs:

  - job_name: prometheus

    static_configs:
      - targets:
          - prometheus:9090


  - job_name: node

    static_configs:
{% for host in groups['app_servers'] %}
      - targets:
          - "{{ hostvars[host].ansible_host }}:9100"
        labels:
          server: "{{ host }}"
{% endfor %}


  - job_name: cadvisor

    static_configs:
{% for host in groups['app_servers'] %}
      - targets:
          - "{{ hostvars[host].ansible_host }}:8080"
        labels:
          server: "{{ host }}"
{% endfor %}


  - job_name: fastapi

    scheme: https
    metrics_path: /metrics

    tls_config:
      insecure_skip_verify: true

    static_configs:
{% for host in groups['app_servers'] %}
      - targets:
          - "{{ hostvars[host].ansible_host }}:443"
        labels:
          server: "{{ host }}"
{% endfor %}
